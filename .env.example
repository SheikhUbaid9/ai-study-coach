# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit it, never paste it into a chat.

# --- Which model provider ------------------------------------------------
# groq | huggingface | gemini | ollama
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_key_here

# Optional: override the model. Run `python study-coach/list_models.py` to see
# what your provider actually offers — they retire models regularly.
# LLM_MODEL=openai/gpt-oss-120b

# --- Where ingested books are stored ------------------------------------
# file = local .npy + .jsonl (no setup) | pgvector = Postgres
STORE_BACKEND=pgvector

# Supabase: use the SESSION POOLER string (port 5432), not the direct host.
PG_DSN=postgresql://postgres.yourref:YOURPASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# --- Optional ------------------------------------------------------------
# Parse only the first N pages — use ~10 to trial a scanned book quickly.
# PAGE_LIMIT=10

# Turn the off-topic guardrail off while developing.
# GUARDRAIL=off
