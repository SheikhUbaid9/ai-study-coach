# Secrets - never commit
.env
.env.local
*.pem
*.key

# Virtual environment (recreated from requirements.txt)
.venv/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Ingestion artefacts - large, machine-specific, regenerated by running the pipeline
textbook-rag/out/
textbook-rag/books/*.pdf

# OS / editor noise
.DS_Store
Thumbs.db

# LangGraph Studio local runtime state (pickled checkpoints)
.langgraph_api/
